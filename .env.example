# ─── App ───────────────────────────────────────────────────────────────
APP_BASE_URL=http://localhost:3000
NODE_ENV=development

# ─── Postgres ──────────────────────────────────────────────────────────
# Development lokal via docker compose (service db).
POSTGRES_USER=komunifind
POSTGRES_PASSWORD=komunifind_dev
POSTGRES_DB=komunifind
# Production (Vercel): isi dengan connection string POOLER Supabase (port 6543).
DATABASE_URL=postgres://komunifind:komunifind_dev@localhost:5433/komunifind?sslmode=disable

# ─── Auth ──────────────────────────────────────────────────────────────
# WAJIB diganti dengan nilai acak di production.
JWT_SECRET=change-me-min-32-chars-please-000000
JWT_TTL_HOURS=168

# Login cepat tanpa Google untuk development. JANGAN aktifkan di production.
DEV_LOGIN=false

# ─── Google OAuth ──────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# ─── Upload ────────────────────────────────────────────────────────────
# local = tulis ke disk (development). supabase = Supabase Storage (production).
STORAGE_DRIVER=local
# Boleh relatif terhadap cwd server, tapi server standalone berjalan dari
# dalam .next/standalone — untuk development lokal pakai absolute path.
# Contoh Docker: UPLOAD_DIR=/data/uploads
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_BYTES=5242880

# ─── Supabase (production) ─────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_STORAGE_BUCKET=uploads
# Service-role key: hanya di server, JANGAN pernah ke browser.
SUPABASE_SERVICE_ROLE_KEY=

# ─── SMTP (dev: Mailtrap, prod: Resend) ────────────────────────────────
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Komunifind <no-reply@komunifind.test>
