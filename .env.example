# ─── App ───────────────────────────────────────────────────────────────
APP_BASE_URL=http://localhost:8088
NODE_ENV=development

# ─── Postgres ──────────────────────────────────────────────────────────
POSTGRES_USER=komunifind
POSTGRES_PASSWORD=komunifind_dev
POSTGRES_DB=komunifind
DATABASE_URL=postgres://komunifind:komunifind_dev@db:5432/komunifind?sslmode=disable

# ─── API (Go) ──────────────────────────────────────────────────────────
API_PORT=8080
# Dipakai web (server-side) untuk memanggil API
API_BASE_URL=http://api:8080
# Dipakai nginx untuk routing langsung /api/v1/*
JWT_SECRET=change-me-min-32-chars-please-000000
INTERNAL_SECRET=change-me-internal-shared-secret
JWT_TTL_HOURS=168

# Login cepat tanpa Google untuk development. JANGAN aktifkan di production.
DEV_LOGIN=false

# ─── Google OAuth ──────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8088/api/auth/google/callback

# ─── Upload ────────────────────────────────────────────────────────────
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_BYTES=5242880

# ─── SMTP (dev: Mailtrap, prod: Resend/Brevo) ──────────────────────────
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Komunifind <no-reply@komunifind.test>
